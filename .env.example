# Copy to .env and use a freshly generated API key. Never share .env.
AI_API_BASE_URL=https://apimira.com/v1
AI_API_KEY=
AI_IMAGE_MODEL=openai/gpt-image-2.5-sunburst
# Vision model for mandatory checks before generation and before delivery.
AI_MODERATION_MODEL=openai/gpt-5.4-mini
PORT=3000
HOST=127.0.0.1
DEMO_PAYMENTS=true
# Set these before first start to create the administrator account.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional private mode: comma-separated invited emails. Any value closes registration.
ACCESS_EMAILS=
# Set false to close public registration even when ACCESS_EMAILS is empty.
REGISTRATION_OPEN=true
